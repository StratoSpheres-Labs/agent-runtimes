{
  "name": "@stratosphereslab/agent-runtimes",
  "version": "0.1.3",
  "description": "Universal runtime layer for local AI coding agents — unified Runtime → Session → Run → RuntimeEvent API",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StratoSpheres-Labs/agent-runtimes.git"
  },
  "keywords": [
    "agent",
    "runtime",
    "opencode",
    "claude",
    "codex",
    "compatibility-layer",
    "ai"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agent-runtimes": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit",
    "example": "tsx examples/basic.ts",
    "example:bff": "tsx examples/bff-sse.ts",
    "test:e2e:round1": "tsx test/e2e-round1.ts",
    "test:e2e:round2": "tsx test/e2e-round2.ts",
    "compat:record": "tsx scripts/compat-record.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11"
  },
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "tests"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.28.2"
    }
  },
  "author": "",
  "bugs": {
    "url": "https://github.com/StratoSpheres-Labs/agent-runtimes/issues"
  },
  "homepage": "https://github.com/StratoSpheres-Labs/agent-runtimes#readme"
}
